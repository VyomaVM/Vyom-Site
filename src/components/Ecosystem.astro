---
const tools = [
  { icon: '💻', name: 'CLI',        desc: '25+ commands for full microVM lifecycle, snapshots, live teleportation, and compose stacks directly from terminal.', status: 'Shipped', tagClass: 'tag--green' },
  { icon: '🎨', name: 'Dashboard',  desc: 'Built-in Web UI with live metrics, console, and interactive topology inspector at localhost:8080.', status: 'Active', tagClass: 'tag--cyan' },
  { icon: '📦', name: 'Compose',    desc: 'Multi-VM stacks with auto-discovery of docker-compose.yml and compose.yaml. Zero migration.', status: 'Shipped', tagClass: 'tag--green' },
  { icon: '⚡', name: 'Swarm & Mesh', desc: 'VXLAN mesh clustering, WireGuard cross-WAN encryption, and live teleportation.', status: 'Shipped', tagClass: 'tag--green' },
  { icon: '🔧', name: 'SDK',        desc: 'Official client libraries for Python (pip install vyoma), Go, and Rust.', status: 'Active', tagClass: 'tag--cyan' },
  { icon: '☸️', name: 'vk8s CRI',   desc: 'Kubernetes CRI v1 plugin. Run Pods as hardware-isolated microVMs.', status: 'CRI v1', tagClass: 'tag--gold' },
  { icon: '🌐', name: 'Vyoma Hub',  desc: 'OCI registry + Docker Hub bridge. Curated base images.', status: 'Planned', tagClass: 'tag--gold' },
  { icon: '🖥',  name: 'Studio',    desc: 'Visual compose stack editor and real-time network topology visualizer built directly into Web Dashboard.', status: 'Active', tagClass: 'tag--cyan' },
];
---

<section class="sec sec--border">
  <div class="wrap">
    <div style="text-align:center;display:flex;flex-direction:column;align-items:center">
      <p class="label">Ecosystem</p>
      <h2 class="heading--sm" style="margin-top:0.75rem">
        Not just a runtime.<br/><span class="grad">A complete platform.</span>
      </h2>
      <p class="subheading" style="margin-top:1rem;text-align:center">
        CLI, dashboard, compose, clustering, SDK, registry — all built-in or coming soon.
      </p>
    </div>

    <div class="g g4 eco__grid">
      {tools.map((t) => (
        <div class="card eco__card">
          <div class="eco__top">
            <span class="eco__icon">{t.icon}</span>
            <span class={`tag ${t.tagClass || (t.status === 'Shipped' ? 'tag--green' : 'tag--gold')}`}>{t.status}</span>
          </div>
          <h3 class="eco__name">{t.name}</h3>
          <p class="eco__desc">{t.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.eco__grid { margin-top: 3.5rem; }
.eco__card { padding: 1.5rem; }
.eco__top  { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; }
.eco__icon { font-size: 1.5rem; }
.eco__name { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.25rem; }
.eco__desc { font-size: 0.8125rem; color: var(--text-dim); line-height: 1.6; }
</style>
